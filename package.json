{
  "name": "baytline",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @baytline/web dev",
    "build": "pnpm --filter @baytline/web build",
    "start": "pnpm --filter @baytline/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:setup": "pnpm --filter @baytline/db setup:local",
    "db:migrate": "pnpm --filter @baytline/db migrate",
    "db:bootstrap-admin": "pnpm --filter @baytline/identity bootstrap-admin",
    "db:seed-dev": "pnpm --filter @baytline/identity seed:dev"
  }
}
