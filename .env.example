# Copy to apps/web/.env.local for local development. Never commit real values.
# Shared/production values come from the deployment's secret manager.

# Public base URL, used to build invitation and password-reset links.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 16+) ---------------------------------------------
# Three roles with different powers; see docs/identity.md.
DATABASE_APP_URL=postgres://baytline_app:CHANGE_ME@localhost:5432/baytline
DATABASE_AUTH_URL=postgres://baytline_auth:CHANGE_ME@localhost:5432/baytline
# Migrations only. Never needed by the running web app.
DATABASE_OWNER_URL=postgres://baytline_owner:CHANGE_ME@localhost:5432/baytline
# Local setup only (creates roles and databases). Leave unset everywhere else.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# --- Email delivery ----------------------------------------------------------
# No provider is connected yet. Leave unset: invitation links are then shown to the
# inviting admin, and password-reset emails are unavailable (the UI says so).
# MAIL_PROVIDER=
# In development only, set to "console" to print reset links to the server log.
# MAIL_DEV_OUTBOX=console

# --- Local placeholder accounts (development only) -------------------------
# Password for accounts created by `pnpm db:seed-dev`. Pick your own; min 12 chars.
# DEV_SEED_PASSWORD=

# --- Future connectors (not built yet; listed in Platform > Integrations) ---
# Add these to the secret manager only when the matching connector ships.
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_PROVIDER_KEY=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# AI_PROVIDER_API_KEY=
# MAPS_API_KEY=
