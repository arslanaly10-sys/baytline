# Copy to apps/web/.env.local for local development. Never commit real values.
# Shared/production values come from the deployment's secret manager.

# Public base URL, used to build invitation and password-reset links.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 16+) ---------------------------------------------
# Three roles with different powers; see docs/identity.md.
DATABASE_APP_URL=postgres://baytline_app:CHANGE_ME@localhost:5432/baytline
DATABASE_AUTH_URL=postgres://baytline_auth:CHANGE_ME@localhost:5432/baytline
# Migrations only. Never needed by the running web app.
DATABASE_OWNER_URL=postgres://baytline_owner:CHANGE_ME@localhost:5432/baytline
# Local setup only (creates roles and databases). Leave unset everywhere else.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# --- Email delivery (SMTP connector) -----------------------------------------
# Any SMTP service. smtps:// (port 465) or smtp:// on 587 with STARTTLS; credentials in the URL.
# Unset: invitation links are shown to the inviting admin and password reset says it's unavailable.
# Then run the check in Platform > Integrations (it signs in and sends nothing).
# MAIL_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM="Baytline <no-reply@example.com>"
# In development only, set to "console" to print emails to the server log instead.
# MAIL_DEV_OUTBOX=console

# --- Document storage (S3-compatible connector) -----------------------------
# The check reads the bucket's metadata and writes nothing. STORAGE_ENDPOINT only for
# non-AWS services (https only).
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=

# --- Two-step sign-in (MFA) -------------------------------------------------
# 32 random bytes, base64: encrypts authenticator secrets at rest. Required in production
# (platform staff can't use the platform without MFA). Generate with: openssl rand -base64 32
# Development uses a fixed local key when unset. Changing it invalidates every enrolled factor.
# BAYTLINE_MFA_KEY=

# --- AI provider (milestone 10) ---------------------------------------------
# AI_PROVIDER_API_KEY=

# --- Local placeholder accounts (development only) -------------------------
# Password for accounts created by `pnpm db:seed-dev`. Pick your own; min 12 chars.
# DEV_SEED_PASSWORD=

# --- Future connectors (not built yet; listed in Platform > Integrations) ---
# Add these to the secret manager only when the matching connector ships.
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_PROVIDER_KEY=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# AI_PROVIDER_API_KEY=
# MAPS_API_KEY=
